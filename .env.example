# ==========================================
# InfraSafe Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env files with real secrets to git!
#
# [AUD-021] This file is aligned to the actual `process.env.*` surface in src/.
# Required vars are uncommented (with CHANGE_ME placeholders); optional/tuning
# vars are commented with their in-code defaults.

# ------------------------------------------
# Server Settings
# ------------------------------------------
# NODE_ENV: 'development' for local work, 'production' for deployed servers.
# Production-mode toggles: stricter Helmet CSP (no 'unsafe-inline'), disabled
# Swagger UI, redacted error responses, extra env-var requirements (CORS_ORIGINS).
PORT=3000
NODE_ENV=development
# REPLICA_COUNT: informational/operational replica count (server logs + multi-
# replica guards). Default 1 if unset.
# REPLICA_COUNT=1

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
# DB_HOST: use 'localhost' for bare-metal node, 'postgres' for docker compose.
# DB_USER:
#   dev   → infrasafe_app (matches POSTGRES_USER in docker-compose.unified.yml)
#   prod  → infrasafe_runtime  (least-privilege runtime role from P0-5 / migration 017)
# DB_PASSWORD: wrap in single quotes if it contains '#', '$', '\', spaces, or other
#              shell-special characters; dotenv parses '#' as a comment otherwise.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=infrasafe
DB_USER=infrasafe_app
DB_PASSWORD='CHANGE_ME'
# Connection-pool tuning (pg Pool). Defaults applied in src/config/database.js.
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT=30000
# DB_POOL_CONNECT_TIMEOUT=10000

# ------------------------------------------
# JWT Authentication
# ------------------------------------------
# Generate secure secrets with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
# [SEC-34h] Dedicated secret for 2FA temp-tokens (scope:'2fa'). In production
# this is REQUIRED and MUST differ from JWT_SECRET (env.js fails fast otherwise).
# In dev/test it may be omitted — the code falls back to JWT_SECRET.
JWT_2FA_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# Optional: access-token expiration (default in code if not set)
# JWT_EXPIRES_IN=15m
# [H-5] Operator escape hatch: in production, a token-blacklist DB/circuit-breaker
# outage now fails CLOSED (503) by default instead of silently fail-open. Set to
# 'true' to restore the old fail-open behavior during an incident (dev/test are
# unaffected — they always fail open).
# AUTH_BLACKLIST_FAIL_OPEN=false

# ------------------------------------------
# Auth cookies (httpOnly)
# ------------------------------------------
# [M-13] COOKIE_SIGNING_SECRET удалён: подписанные cookie никто не читал
# (req.signedCookies без потребителей), внутри cookie лежит JWT со своей подписью.
# Send cookies with the Secure flag (production behind HTTPS). Default off in dev.
# SECURE_COOKIES=true

# ------------------------------------------
# 2FA (TOTP) Encryption
# ------------------------------------------
# Generate: openssl rand -base64 32  (at least 32 chars of random data)
TOTP_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# ------------------------------------------
# Redis (optional — required only for multi-replica deployment)
# ------------------------------------------
# Leave empty / unset → app falls back to in-memory rate-limiter, cache,
# and webhook dedup (single-replica only).
# Set → enables Redis-backed multi-replica safe stores.
# Docker Compose service name = 'redis'; port 6379.
# Auth (SEC-21): prod Redis runs with requirepass, set in the mounted
# redis-config/redis.conf (see redis-config/README.md) — NOT via a compose
# command flag. Mirror the SAME password here:
#   REDIS_URL=redis://:<hexpw>@redis:6379/0
# REDIS_URL=redis://redis:6379/0

# ------------------------------------------
# Logging
# ------------------------------------------
LOG_LEVEL=info

# ------------------------------------------
# CORS (comma-separated origins)
# ------------------------------------------
# Required in production — server reads CORS_ORIGINS (plural). Also gates the
# SEC-23 CSRF Origin check for cookie mutations. Do NOT use `*`; list exact origins.
CORS_ORIGINS=http://localhost:8088

# ------------------------------------------
# Materialized-view refresh scheduler (Sprint 6 / P0-6)
# ------------------------------------------
# MV_REFRESH_ENABLED=true            # set false in tests; otherwise leave on
# MV_REFRESH_INTERVAL_SECONDS=60     # clamped to [10, 3600]

# ------------------------------------------
# Alert verification + reopen subsystem (Sprint 10)
# ------------------------------------------
# Master gate — false = worker created but never ticks (flip only via the
# CR-window runbook). TICK_MS clamped to [5000, 60000].
# ALERT_VERIFICATION_ENABLED=false
# ALERT_VERIFICATION_TICK_MS=15000

# ------------------------------------------
# UK Integration (ENV-only secrets — required if uk_integration_enabled=true in DB)
# ------------------------------------------
# Outbound: InfraSafe signs, UK verifies (Sprint 9). Shared HMAC secret.
UK_WEBHOOK_SECRET=CHANGE_ME_SHARED_SECRET_WITH_UK_BOT
# Inbound: UK signs, InfraSafe verifies.
# ОБЯЗАТЕЛЬНА В PRODUCTION. Fallback на UK_WEBHOOK_SECRET УДАЛЁН (R2-18):
# отсутствие значения теперь fail-close — вебхуки отвергаются, а в prod
# приложение не стартует вовсе.
INFRASAFE_WEBHOOK_SECRET=CHANGE_ME_SHARED_SECRET_WITH_UK_BOT
# Required in production to prevent SSRF via DNS rebinding.
UK_API_ALLOWED_HOSTS=uk-bot-api.example.com
# Bare host for the outbound sender — client appends the webhook path.
# Prod canonical: https://infrasafe.uz/uk
# UK_API_URL=https://infrasafe.uz/uk
# Master gate for the HMAC-webhook outbound channel (drain worker). Default off
# until UK Phase 2 + secret rotation completes.
# UK_USE_WEBHOOK_SENDER=false
# Drain tick in ms (clamped [500, 60000]); default ≈30/min.
# UK_OUTBOX_DRAIN_INTERVAL_MS=2000
# Dead-letter TTL: outbox rows older than this (hours) are marked dead instead
# of bursting stale tickets to UK on a sender-flag flip.
# UK_OUTBOX_MAX_AGE_HOURS=24
# Dual-secret rotation: set UK_WEBHOOK_SECRET_NEXT to the NEW value, then flip
# UK_USE_NEXT_SECRET=true to switch the sender to it.
# UK_WEBHOOK_SECRET_NEXT=CHANGE_ME_NEXT_SECRET
# UK_USE_NEXT_SECRET=false
# [AUD-006] Master gate for the alert.escalated UK notification (voltage severity
# escalate-in-place). Default off until UK confirms it treats alert.escalated as
# an urgency upgrade on the existing request (by alert_id). When true, also set
# UK_USE_WEBHOOK_SENDER=true so the drain worker delivers.
UK_ESCALATION_NOTIFY=false
# [H-4] Shared secret UK sends in the `x-service-token` header when calling
# GET /uk-requests-metrics.
# ОБЯЗАТЕЛЬНА В PRODUCTION (PR-6): без неё приложение не стартует —
# см. PRODUCTION_REQUIRED_VARS в src/config/env.js. Значение должно быть
# согласовано с УК до деплоя (см.
# docs/audit/2026-05-24-ARCH-114-uk-requests-inventory-spec.md).
UK_INVENTORY_TOKEN=CHANGE_ME_SHARED_SECRET_WITH_UK_BOT

# ------------------------------------------
# Telemetry ingestion (H-3)
# ------------------------------------------
# HMAC service-key for POST /metrics/telemetry (header x-telemetry-signature,
# scheme t=<unix>,v1=<hex> — same as the UK webhook signatures above).
# ОБЯЗАТЕЛЬНА В PRODUCTION (PR-6): без неё приложение не стартует —
# см. PRODUCTION_REQUIRED_VARS в src/config/env.js. Генерация:
# openssl rand -hex 32
TELEMETRY_HMAC_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ------------------------------------------
# Прикладные метрики Prometheus (AR-2 / Task 6)
# ------------------------------------------
# Bearer-токен для GET /internal/metrics. Скрейпит Alloy из отдельного
# репозитория profk-observability (job infrasafe_app, интервал 30 с);
# на его стороне тот же секрет лежит в
# /etc/profk-observability/secrets/infrasafe_metrics_token.
# Fail-closed: пока переменная не задана, эндпоинт отвечает 503, а НЕ отдаёт
# метрики всем подряд. Публичный эдж этот путь не проксирует (в приложение
# уходит только /api/), но это второй рубеж, а не единственный.
# Генерация: openssl rand -hex 32
INTERNAL_METRICS_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32

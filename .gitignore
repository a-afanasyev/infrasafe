# ==========================================
# КРИТИЧНО ДЛЯ БЕЗОПАСНОСТИ — Environment файлы
# ==========================================
.env
.env.*
!.env.example
generator/.env

# [SEC-21] Redis config carries requirepass — operator-managed, never commit.
# Keep the template + README tracked.
redis-config/redis.conf

# ==========================================
# Node.js — зависимости и кэш
# ==========================================
node_modules/
.npm
jspm_packages/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.node_repl_history

# ==========================================
# Логи
# ==========================================
logs/
*.log

# ==========================================
# Frontend build output (PERF-003 / Phase 12B.4)
# ==========================================
public/dist/

# [SEC-14/15] Deploy staging for extracted frontend dist (C-extract).
# Kept OUTSIDE public/ so the edge never serves it and the build never bakes it.
.deploy/

# ==========================================
# Runtime data
# ==========================================
pids/
*.pid
*.seed
*.pid.lock

# ==========================================
# Тесты — покрытие и артефакты
# ==========================================
coverage/
.nyc_output
test-results/
playwright-report/
# [AUD-041] generated test outputs — load/smoke reports + coverage are
# regenerated on every run (jest coverageDirectory, run-load/smoke-tests.sh).
tests/reports/


FROM node:26-alpine

WORKDIR /app

# Создаем пользователя для безопасности
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Копируем только package files для установки зависимостей
COPY package*.json ./

# Устанавливаем все зависимости (включая dev для разработки).
# --ignore-scripts: postinstall (npm run build:frontend, Phase 12B.4)
# требует build/ + public/, которых в этом слое ещё нет (мы копируем
# только package*.json). На dev frontend bundle собирается на host
# через `npm run build:frontend` или `:watch` — nginx читает public/
# через volume mount, так что отдельный build внутри dev-контейнера
# не нужен. Та же стратегия используется в Dockerfile.prod и
# Dockerfile.frontend-only.
RUN npm install --ignore-scripts

# Создаем директорию для логов
RUN mkdir -p logs

# Меняем владельца файлов
RUN chown -R nodejs:nodejs /app

# Переключаемся на непривилегированного пользователя
USER nodejs

# Открываем порт
EXPOSE 3000

# Запускаем приложение в dev режиме с горячей перезагрузкой
CMD ["npm", "run", "dev"] 
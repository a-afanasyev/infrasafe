{
  "name": "infrasafe",
  "version": "1.0.1",
  "description": "Система мониторинга зданий и контроллеров",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/ public/ tests/ generator/ --max-warnings 0",
    "test": "jest",
    "test:unit": "jest tests/jest/unit",
    "test:integration": "jest tests/jest/integration",
    "test:db": "jest tests/jest/db --testPathIgnorePatterns=/node_modules/ --runInBand",
    "test:security": "jest tests/jest/security",
    "test:smoke": "bash tests/smoke/run-smoke-tests.sh",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:smoke",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config tests/jest/e2e/jest.e2e.config.js --runInBand --testTimeout=15000",
    "migrate:test": "bash tests/migrate/run-migrate-tests.sh",
    "build:frontend": "node build/esbuild.config.mjs",
    "build:frontend:watch": "node build/esbuild.config.mjs --watch",
    "hooks:install": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "postinstall": "npm run hooks:install && npm run build:frontend"
  },
  "keywords": [
    "monitoring",
    "buildings",
    "controllers",
    "metrics",
    "iot",
    "smart-building",
    "infrastructure",
    "habitat-monitoring",
    "leaflet",
    "docker",
    "nodejs",
    "postgresql"
  ],
  "author": "InfraSafe Development Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/a-afanasyev/infrasafe.git"
  },
  "homepage": "https://github.com/a-afanasyev/infrasafe#readme",
  "bugs": {
    "url": "https://github.com/a-afanasyev/infrasafe/issues"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^4.18.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "js-yaml": "^5.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/jest/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/jest/e2e/",
      "/tests/jest/db/",
      "/.claude/worktrees/",
      "/.deploy/"
    ],
    "modulePathIgnorePatterns": [
      "/.claude/worktrees/",
      "/.deploy/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "public/utils/**/*.js"
    ],
    "coverageDirectory": "tests/reports/coverage",
    "coverageReporters": [
      "text",
      "html",
      "lcov"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest/setup.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      },
      "public/utils/": {
        "branches": 69,
        "functions": 85,
        "lines": 79,
        "statements": 77
      },
      "public/utils/brandTokens.js": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      },
      "public/utils/powerUtils.js": {
        "branches": 56,
        "functions": 80,
        "lines": 77,
        "statements": 74
      },
      "public/utils/safeJsonParser.js": {
        "branches": 57,
        "functions": 75,
        "lines": 59,
        "statements": 60
      },
      "public/utils/ukRulesValidation.js": {
        "branches": 42,
        "functions": 100,
        "lines": 60,
        "statements": 57
      }
    }
  }
}

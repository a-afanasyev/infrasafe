{
  "name": "infrasafe",
  "version": "1.0.1",
  "description": "Система мониторинга зданий и контроллеров",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/ public/ tests/ --max-warnings 0",
    "test": "jest",
    "test:unit": "jest tests/jest/unit",
    "test:integration": "jest tests/jest/integration",
    "test:security": "jest tests/jest/security",
    "test:smoke": "bash tests/smoke/run-smoke-tests.sh",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:smoke",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config tests/jest/e2e/jest.e2e.config.js --runInBand --testTimeout=15000",
    "migrate:test": "bash tests/migrate/run-migrate-tests.sh",
    "build:frontend": "node build/esbuild.config.mjs",
    "build:frontend:watch": "node build/esbuild.config.mjs --watch",
    "postinstall": "npm run build:frontend"
  },
  "keywords": [
    "monitoring",
    "buildings",
    "controllers",
    "metrics",
    "iot",
    "smart-building",
    "infrastructure",
    "habitat-monitoring",
    "leaflet",
    "docker",
    "nodejs",
    "postgresql"
  ],
  "author": "InfraSafe Development Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/a-afanasyev/infrasafe.git"
  },
  "homepage": "https://github.com/a-afanasyev/infrasafe#readme",
  "bugs": {
    "url": "https://github.com/a-afanasyev/infrasafe/issues"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "js-yaml": "^5.2.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/jest/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/jest/e2e/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageDirectory": "tests/reports/coverage",
    "coverageReporters": [
      "text",
      "html",
      "lcov"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest/setup.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}

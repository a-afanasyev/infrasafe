# Multi-stage Dockerfile для InfraSafe Habitat IQ

# [SEC-14/15] App build stage — devDependencies (esbuild) собирают public/dist.
# Этот стейдж отбрасывается: его devDeps НЕ попадают в runtime-образ.
# Node 20+ обязателен (esbuild >=0.20).
FROM node:22-alpine AS app-builder

WORKDIR /app

COPY package*.json ./
# С devDeps (esbuild нужен для build:frontend). --ignore-scripts: postinstall
# (build:frontend) запускаем явно ниже, когда build/ и public/ уже на месте.
RUN npm ci --ignore-scripts

COPY build/ ./build/
COPY public/ ./public/
RUN npm run build:frontend

# [SEC-14/15] App runtime stage — immutable production-образ.
# Образец — Dockerfile.prod: только prod-deps (`--omit=dev` → нет esbuild/nodemon),
# только src/ + public/ (с baked dist из builder), CMD `npm start` (НЕ nodemon).
# Секреты/.git/scripts НЕ копируются и НЕ монтируются (compose снял `.:/app`).
FROM node:22-alpine AS app

WORKDIR /app

# curl нужен HEALTHCHECK — в node:22-alpine его нет (как в Dockerfile.prod).
RUN apk add --no-cache curl procps

RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

# Слой-порядок ради кэша: deps до исходников.
COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY --chown=nodejs:nodejs src/ ./src/
# Весь public (с baked dist) — express.static('../public') отдаёт его (src/server.js).
COPY --from=app-builder --chown=nodejs:nodejs /app/public ./public

# Named volume app_logs монтируется в /app/logs — каталог должен быть писуем nodejs.
RUN mkdir -p /app/logs && chown -R nodejs:nodejs /app/logs

ENV NODE_ENV=production

USER nodejs

EXPOSE 3000

# [B-014] 127.0.0.1, не localhost — alpine резолвит localhost в ::1, а app слушает IPv4.
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD curl -f http://127.0.0.1:3000/health || exit 1

CMD ["npm", "start"]

# Frontend Stage
FROM nginx:alpine AS frontend

# Копируем конфигурацию Nginx из существующего файла
COPY nginx.conf /etc/nginx/nginx.conf

WORKDIR /usr/share/nginx/html

# [B-002] HTML pages live in /srv/frontend-html (mount target separate
# from /usr/share/nginx/html where css/public/data live). nginx config
# routes HTML via `root /srv/frontend-html;` in its location block.
COPY frontend-html/ /srv/frontend-html/

# Копируем статические ресурсы
COPY css/ ./css/
COPY public/ ./public/
COPY data/ ./data/

# Создаем пользователя для безопасности
RUN addgroup -g 1001 -S nginx-user && \
    adduser -S nginx-user -u 1001 && \
    chown -R nginx-user:nginx-user /usr/share/nginx/html && \
    chown -R nginx-user:nginx-user /var/cache/nginx && \
    chown -R nginx-user:nginx-user /var/log/nginx && \
    chown -R nginx-user:nginx-user /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown nginx-user:nginx-user /var/run/nginx.pid

USER nginx-user

# Открываем порт
EXPOSE 8080

# Запускаем Nginx
CMD ["nginx", "-g", "daemon off;"]
# Multi-stage Dockerfile для InfraSafe Habitat IQ

# Backend Stage
# Node 20+ обязателен (см. CLAUDE.md tech stack: Node.js 20+). Старый
# `node:18-alpine` ломал postinstall (esbuild >=0.20 требует Node 20+).
FROM node:20-alpine AS backend

WORKDIR /app

# Копируем package files
COPY package*.json ./

# Устанавливаем зависимости.
# --ignore-scripts: postinstall (Phase 12B.4 `npm run build:frontend`)
# не может выполниться сейчас — build/ и public/ ещё не скопированы.
# Bundle создаётся явным шагом после `COPY . .` ниже.
RUN npm install --ignore-scripts

# Копируем исходный код
COPY . .

# Теперь когда build/ и public/ доступны — собираем frontend bundle.
RUN npm run build:frontend

# Создаем директорию для логов
RUN mkdir -p logs

# Создаем пользователя для безопасности
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app

USER nodejs

# Открываем порт
EXPOSE 3000

# Запускаем приложение
CMD ["npm", "run", "dev"]

# Frontend Stage
FROM nginx:alpine AS frontend

# Копируем конфигурацию Nginx из существующего файла
COPY nginx.conf /etc/nginx/nginx.conf

WORKDIR /usr/share/nginx/html

# Копируем HTML файлы
COPY index.html .
COPY *.html .

# Копируем статические ресурсы
COPY css/ ./css/
COPY public/ ./public/
COPY data/ ./data/

# Создаем пользователя для безопасности
RUN addgroup -g 1001 -S nginx-user && \
    adduser -S nginx-user -u 1001 && \
    chown -R nginx-user:nginx-user /usr/share/nginx/html && \
    chown -R nginx-user:nginx-user /var/cache/nginx && \
    chown -R nginx-user:nginx-user /var/log/nginx && \
    chown -R nginx-user:nginx-user /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown nginx-user:nginx-user /var/run/nginx.pid

USER nginx-user

# Открываем порт
EXPOSE 8080

# Запускаем Nginx
CMD ["nginx", "-g", "daemon off;"]